DATASOURCES:
  - name: 'segsocial_consolidado'
    type: 'LOCAL'
    source: 'test_data/segsocial_consolidado.parquet'
  - name: 'iris'
    type: 'LOCAL'
    source: 'test_data/iris.csv'
  - name: 'test_cases'
    type: 'LOCAL'
    source: 'test_data/test.csv'
  - name: 'agrupado'
    type: 'QUERY'
    source: |
      SELECT
        Fecha,
        Comunidad,
        Provincia,
        Origen,
        Origen2,
        SUM(IF(Tipo='Ingreso', Valor, NULL))/1e6 AS Ingreso,
        SUM(IF(Tipo='Gasto', Valor, NULL))/1e6 AS Gasto,
      FROM
        segsocial_consolidado
      GROUP BY 1, 2, 3, 4, 5
QUERIES:
  - name: 'Test Query'
    query: |
      SELECT
        *
      FROM
        segsocial_consolidado
  - name: 'Another Query'
    query: |
      SELECT DISTINCT
        Fecha
      FROM
        segsocial_consolidado
CHARTS:
